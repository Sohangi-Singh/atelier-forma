# Copy to .env.local for local development. Never commit real values.

# Public URL used for canonical links, Open Graph URLs, robots.txt and sitemap.xml.
# On Vercel this can be omitted: the production domain is detected automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Enquiry form delivery (Resend) -------------------------------------------
# All three values are required. If any is missing, the contact form clearly
# states that online enquiries are not configured and nothing is sent.

# API key from https://resend.com/api-keys (server-side only).
RESEND_API_KEY=

# Inbox that should receive enquiries.
ENQUIRY_TO_EMAIL=

# Sender on a domain you have verified in Resend, e.g. "Studio Enquiries <enquiries@yourdomain.com>".
ENQUIRY_FROM_EMAIL=
